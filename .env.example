# Copier ce fichier en ".env" puis remplir les vraies valeurs.
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).
# Modèle (palier gratuit Groq : https://console.groq.com/keys)
GROQ_API_KEY=a_remplir
MODELE=openai/gpt-oss-120b
# Serveur MCP du catalogue
CATALOGUE_DB=serveur_mcp/catalogue.db
MCP_TRANSPORT=stdio          # stdio (par défaut) ou http
MCP_URL=http://127.0.0.1:8000/mcp   # utilisé seulement si MCP_TRANSPORT=http
# Google (compte de TEST de l'équipe, jamais un compte personnel)
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json
FUSEAU=Africa/Dakar
